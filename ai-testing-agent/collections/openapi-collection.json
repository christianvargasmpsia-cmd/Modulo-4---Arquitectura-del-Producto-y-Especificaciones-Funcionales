        {
          "name": "auth",
          "item": [
            {
              "name": "register",
              "item": [
                {
                  "name": "register",
                  "event": [
                    {
                      "listen": "prerequest",
                      "script": {
                        "exec": [
                          "const timestamp = Date.now();",
                          "",
                          "// Email único para evitar conflictos por duplicados",
                          "pm.variables.set(\"testEmail\", `mcp.test.${timestamp}@umss.edu.bo`);",
                          "",
                          "// El backend exige exactamente 9 dígitos",
                          "const numericTimestamp = String(timestamp).replace(/\\D/g, \"\");",
                          "pm.variables.set(\"testRu\", numericTimestamp.slice(-9));",
                          "",
                          "// El backend utiliza celulares de 8 dígitos",
                          "pm.variables.set(\"testCelular\", `7${numericTimestamp.slice(-7)}`);"
                        ],
                        "type": "text/javascript"
                      }
                    }
                  ],
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "*/*"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"apellidoPaterno\": \"MCP\",\n  \"celular\": \"{{testCelular}}\",\n  \"email\": \"{{testEmail}}\",\n  \"facultad\": \"Ingenieria\",\n  \"nombre\": \"Usuario\",\n  \"nombreTienda\": \"MCP Test Store\",\n  \"password\": \"Test12345!\",\n  \"ru\": \"{{testRu}}\",\n  \"apellidoMaterno\": \"Prueba\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/api/auth/register",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "auth",
                        "register"
                      ]
                    }
                  },
                  "response": []
                }
              ]
            }
          ]
